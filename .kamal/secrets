# Secretos del deploy, leídos de 1Password con `op` (el workflow tiene OP_SERVICE_ACCOUNT_TOKEN).
# Todo está en el vault "DevOps Routines", el único que ve ese service account.
# Este archivo no contiene valores: solo dónde están.
# El item de Chambeando se nombra por su id, que no cambia si se renombra el item.

KAMAL_REGISTRY_PASSWORD=$(op read "op://DevOps Routines/Docker Hub/KAMAL_REGISTRY_PASSWORD")
BACKEND_API_KEY=$(op read "op://DevOps Routines/3hggflvsiuhdvfq47nxs5d3e3q/BACKEND_API_KEY")
LLM_API_KEY=$(op read "op://DevOps Routines/OpenRouter/API_KEY")
# Vacío hasta crear la clave secreta en la bandeja de Vatio: sin ella los avisos quedan pendientes y no se envían.
# Vacío hasta agregar el campo ADMIN_API_KEY al item: sin ella la consola de admin (/admin/*) queda apagada.
ADMIN_API_KEY=$(op read "op://DevOps Routines/3hggflvsiuhdvfq47nxs5d3e3q/ADMIN_API_KEY" 2>/dev/null || true)
VATIO_SERVER_KEY=$(op read "op://DevOps Routines/3hggflvsiuhdvfq47nxs5d3e3q/VATIO_SERVER_KEY" 2>/dev/null || true)
# URL completa del proxy de salida para Computrabajo. Crear este campo en el item de Chambeando antes de desplegar.
COMPUTRABAJO_PROXY_URL=$(op read "op://DevOps Routines/3hggflvsiuhdvfq47nxs5d3e3q/COMPUTRABAJO_PROXY_URL" 2>/dev/null || true)
