#!/bin/sh
# Corre los tests antes de cada push. GitHub Actions solo despliega: los checks corren donde se hace el cambio.
# Se activa solo con `npm install` (script "prepare"). Para saltarlo en una emergencia: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
if [ ! -d node_modules ]; then
  echo "pre-push: falta node_modules, corre npm install" >&2
  exit 1
fi
echo "pre-push: npm test" >&2
NODE_NO_WARNINGS=1 npm test --silent
