# Servidor
PORT=8787
# Clave que Vatio manda como Bearer en cada llamada de herramienta
BACKEND_API_KEY=
DB_PATH=data/pega.db

# Vatio: mensajes salientes por WhatsApp
VATIO_WORKSPACE=pega
VATIO_SERVER_KEY=
VATIO_TEMPLATE=nuevos_avisos

# Modelo que decide si un aviso le sirve a un usuario (API compatible con OpenAI)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5

# Países abiertos (códigos ISO). Los conectores cubren 17; el resto se abre agregándolo aquí.
COUNTRIES=CL,MX,PE,CO

# Ingest
INGEST_EVERY_MINUTES=60
# Portales Jobint por país; quitar uno lo deja fuera
JOBINT_SITES=laborum,bumeran-ar,bumeran-mx,bumeran-pe,multitrabajos,konzerta,bumeran-ve
JOBINT_MAX_PAGES=5
# Computrabajo: páginas de 20 avisos por región en cada corrida
# (sin definir = los 17 países; para limitar: COMPUTRABAJO_SITES=computrabajo-mx,computrabajo-co)
COMPUTRABAJO_MAX_PAGES=3
TRABAJANDO_MAX_PAGES=20
